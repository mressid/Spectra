# Store API (the Spring Boot app in accessories-store-system)
API_URL=http://localhost:8080
# Public address of the product photos (MinIO bucket host)
MEDIA_URL=http://localhost:9010
# Public address of this website, for canonical URLs, sitemap and link previews
SITE_URL=http://localhost:3000
# Shared with the store API: it sends this in X-Revalidate-Secret when calling POST /api/revalidate
REVALIDATE_SECRET=change-me
